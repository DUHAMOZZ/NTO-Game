  scenarioId: scenario_03_echo
  scenarioTitle: "\u0421\u0446\u0435\u043D\u0430\u0440\u0438\u0439 3. \u042D\u0445\u043E"
  dialogue: {fileID: 11400000, guid: 35ee1eb49e8f1cd48a2f9cd60a8eb074, type: 2}
  callerNotesSummary: "\u041E\u043F\u0440\u0435\u0434\u0435\u043B\u0438\u0442\u0435\u043B\u044C
    \u043D\u043E\u043C\u0435\u0440\u0430: \u0414\u0432\u043E\u0440 \u0441 \u043A\u0430\u0447\u0435\u043B\u044F\u043C\u0438.
    \u0414\u0435\u0442\u0441\u043A\u0438\u0439 \u0433\u043E\u043B\u043E\u0441 \u043F\u043E\u0432\u0442\u043E\u0440\u044F\u0435\u0442
    \u043E\u0434\u043D\u0443 \u0438 \u0442\u0443 \u0436\u0435 \u0444\u0440\u0430\u0437\u0443
    \u0441\u043B\u043E\u0432\u043E \u0432 \u0441\u043B\u043E\u0432\u043E."
  targetBuildingId: Building_03
  clueCameraId: Camera_03
  clueSnapshot: {fileID: 0}
  clueDescription: "\u0421\u043D\u0438\u043C\u043E\u043A: \u0414\u0432\u043E\u0440
    \u043F\u0443\u0441\u0442. \u041D\u0438 \u0440\u0435\u0431\u0451\u043D\u043A\u0430,
    \u043D\u0438 \u0432\u0437\u0440\u043E\u0441\u043B\u044B\u0445, \u043D\u0438 \u0441\u043B\u0435\u0434\u043E\u0432
    \u043D\u0430 \u0437\u0435\u043C\u043B\u0435. \u041A\u0430\u0447\u0435\u043B\u0438
    \u0440\u0430\u0441\u043A\u0430\u0447\u0438\u0432\u0430\u044E\u0442\u0441\u044F."
  secondSnapshotDelay: 10
  secondClueSnapshot: {fileID: 0}
  secondClueDescription: "\u0412\u0442\u043E\u0440\u043E\u0439 \u0441\u043D\u0438\u043C\u043E\u043A
    (\u0441\u043F\u0443\u0441\u0442\u044F 10 \u0441\u0435\u043A): \u0434\u0432\u043E\u0440
    \u043F\u0443\u0441\u0442, \u0430 \u043A\u0430\u0447\u0435\u043B\u0438 \u043A\u0430\u0447\u0430\u044E\u0442\u0441\u044F
