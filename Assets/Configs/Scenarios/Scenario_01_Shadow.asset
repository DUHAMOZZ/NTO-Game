  scenarioId: scenario_01_shadow
  scenarioTitle: "\u0421\u0446\u0435\u043D\u0430\u0440\u0438\u0439 1. \u0422\u0435\u043D\u044C"
  dialogue: {fileID: 11400000, guid: c2e983b5dc4687f4e91faef7ce8dc588, type: 2}
  callerNotesSummary: "\u0417\u0432\u043E\u043D\u043E\u043A (\u041F\u0430\u043D\u0438\u043A\u0451\u0440):
    \u041A\u043B\u0435\u043D\u043E\u0432\u0430\u044F 20, \u0440\u044F\u0434\u043E\u043C
    \u0441 \u0431\u0443\u043B\u043E\u0447\u043D\u043E\u0439 (\u043A\u0440\u0430\u0441\u043D\u0430\u044F
    \u0434\u0432\u0435\u0440\u044C). \u0412\u0438\u0434\u0435\u043B \u0432\u044B\u0441\u043E\u043A\u0443\u044E
    \u0442\u0435\u043D\u044C \u043F\u043E\u0434 \u043E\u043A\u043D\u043E\u043C, \u0444\u043E\u043D\u0430\u0440\u044C
    \u0432\u043E \u0434\u0432\u043E\u0440\u0435 \u0433\u043E\u0440\u0438\u0442."
  targetBuildingId: Building_01
  clueCameraId: Camera_01
  clueSnapshot: {fileID: 0}
  clueDescription: "\u0421\u043D\u0438\u043C\u043E\u043A: \u0414\u0432\u043E\u0440
    \u0443 \u0431\u0443\u043B\u043E\u0447\u043D\u043E\u0439. \u0412\u0435\u0442\u043A\u0438
    \u0434\u0435\u0440\u0435\u0432\u0430 \u0443 \u043E\u043A\u043D\u0430, \u0444\u043E\u043D\u0430\u0440\u044C,
    \u0442\u0435\u043D\u044C \u043E\u0442 \u0432\u0435\u0442\u043E\u043A \u0448\u0435\u0432\u0435\u043B\u0438\u0442\u0441\u044F.
    \u0421\u043B\u0435\u0434\u043E\u0432 \u043D\u0430 \u0437\u0435\u043C\u043B\u0435
    \u043D\u0435\u0442, \u043B\u044E\u0434\u0435\u0439 \u0438 \u0441\u0443\u0449\u0435\u0441\u0442\u0432
    \u043D\u0435\u0442."
  secondSnapshotDelay: 0
  secondClueSnapshot: {fileID: 0}
  secondClueDescription: 
  timeLimitSeconds: 0
  timeoutSanityDelta: -8
  timeoutReport: "\u0412\u0440\u0435\u043C\u044F \u0432\u044B\u0448\u043B\u043E.
    \u041F\u043E\u043C\u043E\u0449\u044C \u043D\u0435 \u0443\u0441\u043F\u0435\u043B\u0430."
  step2TimeoutReport: "\u041F\u0435\u0440\u0432\u044B\u0439 \u044D\u0442\u0430\u0436
    \u0437\u0430\u0447\u0438\u0449\u0435\u043D, \u043D\u043E \u0440\u0430\u043D\u0435\u043D\u043E\u043C\u0443
    \u043D\u0438\u043A\u0442\u043E \u043D\u0435 \u043F\u043E\u043C\u043E\u0433."
  step1Rules:
  - squad: {fileID: 11400000, guid: 97e1e5efca5cb234ea17dcae3886cdff, type: 2}
    actionType: 0
    rewardCurrency: 1
    sanityDelta: 3
    radioReport: "\u0413\u0411\u0420 \u043D\u0430 \u043C\u0435\u0441\u0442\u0435.
      \u042D\u0442\u043E \u0432\u0435\u0442\u043A\u0430. \u0416\u0438\u043B\u0435\u0446
      \u0443\u0441\u043F\u043E\u043A\u043E\u0435\u043D."
  - squad: {fileID: 11400000, guid: b466bdd0f4edee44d96e8de62722e9e9, type: 2}
    actionType: 2
    rewardCurrency: 0
    sanityDelta: -1
    radioReport: "\u0422\u044F\u0436\u0451\u043B\u044B\u0439 \u043E\u0442\u0440\u044F\u0434
      \u043D\u0430 \u043C\u0435\u0441\u0442\u0435. \u0423\u0433\u0440\u043E\u0437\u044B
      \u043D\u0435 \u0431\u044B\u043B\u043E, \u0440\u0435\u0441\u0443\u0440\u0441\u044B
      \u043F\u043E\u0442\u0440\u0430\u0447\u0435\u043D\u044B \u0432\u043F\u0443\u0441\u0442\u0443\u044E."
  - squad: {fileID: 11400000, guid: ae53c08b1a9c5dc48a55ad53fc8a4392, type: 2}
    actionType: 2
    rewardCurrency: 0
    sanityDelta: 0
    radioReport: "\u0417\u043D\u0430\u0445\u0430\u0440\u0438 \u043E\u0441\u043C\u043E\u0442\u0440\u0435\u043B\u0438
      \u0434\u0432\u043E\u0440. \u041D\u0435\u0447\u0438\u0441\u0442\u0438 \u043D\u0435\u0442
      \u2014 \u043E\u0431\u044B\u0447\u043D\u0430\u044F \u0442\u0435\u043D\u044C
      \u043E\u0442 \u0432\u0435\u0442\u043A\u0438."
  - squad: {fileID: 11400000, guid: 5aace0ff8d5f4624781c59b60013d767, type: 2}
    actionType: 2
    rewardCurrency: 0
    sanityDelta: 0
    radioReport: "\u0421\u043A\u043E\u0440\u0430\u044F \u043D\u0430 \u043C\u0435\u0441\u0442\u0435.
      \u041F\u043E\u0441\u0442\u0440\u0430\u0434\u0430\u0432\u0448\u0438\u0445 \u043D\u0435\u0442,
      \u043B\u043E\u0436\u043D\u0430\u044F \u0442\u0440\u0435\u0432\u043E\u0433\u0430."
