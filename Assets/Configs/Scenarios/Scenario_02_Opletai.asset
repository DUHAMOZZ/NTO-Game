    \u043E\u0442 \u043F\u043E\u043B\u0430, \u043D\u043E\u0433\u0430 \u043E\u0431\u0432\u0438\u0442\u0430,
    \u0434\u0432\u0435\u0440\u044C \u043D\u0435 \u043E\u0442\u043A\u0440\u044B\u0432\u0430\u0435\u0442\u0441\u044F.
    \u0421\u043E\u0441\u0442\u043E\u044F\u043D\u0438\u0435 \u0442\u044F\u0436\u0451\u043B\u043E\u0435."
  targetBuildingId: Building_02
  clueCameraId: Camera_02
  clueSnapshot: {fileID: 0}
  clueDescription: "\u0421\u043D\u0438\u043C\u043E\u043A: \u0414\u0432\u0443\u0445\u044D\u0442\u0430\u0436\u043D\u044B\u0439
