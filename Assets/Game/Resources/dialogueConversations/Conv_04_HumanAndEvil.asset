  m_Name: Conv_04_HumanAndEvil
  m_EditorClassIdentifier: Assembly-CSharp::AnomalyDispatch.Dialogue.DialogueConversation
  conversationId: conv_04_human_evil
  startNodeId: start
  nodes:
  - id: start
    speaker: "\u0417\u0432\u043E\u043D\u044F\u0449\u0438\u0439 (\u0428\u0451\u043F\u043E\u0442,
      \u0442\u044F\u0436\u0451\u043B\u043E\u0435 \u0434\u044B\u0445\u0430\u043D\u0438\u0435)"
    text: "\u042F... \u044F \u0437\u0430\u043F\u0435\u0440\u0441\u044F \u043D\u0430\u0432\u0435\u0440\u0445\u0443.
      \u0412\u043D\u0438\u0437\u0443 \u043A\u0442\u043E-\u0442\u043E... \u0441\u043A\u0440\u0435\u0431\u0451\u0442\u0441\u044F.
      \u041D\u0435 \u043C\u043E\u0433\u0443... \u0438\u0434\u0442\u0438. \u041D\u043E\u0433\u0430."
    onEnterEffects:
    - flagKey: s4_q1
      type: 1
      value: 0
    - flagKey: s4_q2
      type: 1
      value: 0
    choices: []
    nextNodeId: hub
    isEnding: 0
    endingId: 
  - id: hub
    speaker: "\u041E\u043F\u0435\u0440\u0430\u0442\u043E\u0440 (\u041B\u0438\u043D\u0438\u044F
      \u0441\u0432\u044F\u0437\u0438)"
    text: "\u041E\u0446\u0435\u043D\u0438\u0442\u0435 \u0443\u0433\u0440\u043E\u0437\u0443
      \u0438 \u0434\u0430\u0439\u0442\u0435 \u0441\u043E\u0432\u0435\u0442 \u0432\u044B\u0436\u0438\u0432\u0448\u0435\u043C\u0443:"
    onEnterEffects: []
    choices:
    - text: "\u0412\u044B \u0440\u0430\u043D\u0435\u043D\u044B? \u041D\u0430\u0441\u043A\u043E\u043B\u044C\u043A\u043E
        \u0441\u0438\u043B\u044C\u043D\u043E?"
      targetNodeId: q_wound
      conditions:
      - flagKey: s4_q1
        comparison: 1
        value: 0
      effects:
      - flagKey: s4_q1
        type: 0
        value: 0
      hideIfUnavailable: 1
    - text: "\u0427\u0442\u043E \u0432\u044B \u0441\u043B\u044B\u0448\u0438\u0442\u0435
        \u0432\u043D\u0438\u0437\u0443?"
      targetNodeId: q_downstairs
      conditions:
      - flagKey: s4_q2
        comparison: 1
        value: 0
      effects:
      - flagKey: s4_q2
        type: 0
        value: 0
      hideIfUnavailable: 1
    - text: "\u0417\u0430\u0431\u0430\u0440\u0440\u0438\u043A\u0430\u0434\u0438\u0440\u0443\u0439\u0442\u0435
        \u0434\u0432\u0435\u0440\u044C \u043C\u0435\u0431\u0435\u043B\u044C\u044E
        \u0438 \u043D\u0435 \u0448\u0443\u043C\u0438\u0442\u0435."
      targetNodeId: end_advice
      conditions: []
      effects: []
      hideIfUnavailable: 1
    nextNodeId: 
    isEnding: 0
    endingId: 
  - id: q_wound
    speaker: "\u0417\u0432\u043E\u043D\u044F\u0449\u0438\u0439"
    text: "\u041A\u0440\u043E\u0432\u044C... \u0438\u0434\u0451\u0442. \u042F \u043F\u0435\u0440\u0435\u0432\u044F\u0437\u0430\u043B,
      \u043D\u043E \u0441\u0438\u043B\u044C\u043D\u043E. \u0414\u043E\u043B\u0433\u043E
      \u043D\u0435 \u043F\u0440\u043E\u0434\u0435\u0440\u0436\u0443\u0441\u044C."
    onEnterEffects: []
    choices: []
    nextNodeId: hub
    isEnding: 0
    endingId: 
  - id: q_downstairs
    speaker: "\u0417\u0432\u043E\u043D\u044F\u0449\u0438\u0439"
    text: "\u0421\u043A\u0440\u0435\u0431\u0451\u0442 \u043F\u043E \u0434\u0432\u0435\u0440\u0438.
      \u041F\u043E \u043E\u043A\u043D\u0443. \u041C\u0435\u0434\u043B\u0435\u043D\u043D\u043E.
      \u041E\u043D\u043E \u0437\u043D\u0430\u0435\u0442, \u0447\u0442\u043E \u044F
      \u0437\u0434\u0435\u0441\u044C."
    onEnterEffects: []
    choices: []
    nextNodeId: hub
    isEnding: 0
    endingId: 
  - id: end_advice
    speaker: "\u0417\u0432\u043E\u043D\u044F\u0449\u0438\u0439"
    text: "\u0425\u043E\u0440\u043E\u0448\u043E... \u0434\u0432\u0438\u0433\u0430\u044E
      \u0448\u043A\u0430\u0444... \u0442\u0438\u0445\u043E... \u0422\u043E\u043B\u044C\u043A\u043E
      \u0441\u043A\u043E\u0440\u0435\u0435."
