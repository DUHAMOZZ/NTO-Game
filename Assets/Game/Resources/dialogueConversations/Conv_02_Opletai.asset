  startNodeId: start
  nodes:
  - id: start
    speaker: "\u0417\u0432\u043E\u043D\u044F\u0449\u0430\u044F (\u0428\u0451\u043F\u043E\u0442,
      \u0433\u043E\u0432\u043E\u0440\u0438\u0442 \u043C\u0435\u0434\u043B\u0435\u043D\u043D\u043E)"
    text: "\u0417\u0434\u0440\u0430\u0432\u0441\u0442\u0432\u0443\u0439\u0442\u0435.
      \u041C\u043D\u0435... \u043D\u0443\u0436\u043D\u0430 \u043F\u043E\u043C\u043E\u0449\u044C.
      \u041D\u0435 \u043C\u043E\u0433\u0443 \u0432\u044B\u0439\u0442\u0438. \u0421\u0442\u0435\u043D\u044B...
      \u0441\u0442\u0435\u043D\u044B \u043E\u0431\u0440\u043E\u0441\u043B\u0438 \u0447\u0435\u043C-\u0442\u043E.
      \u0414\u0432\u0435\u0440\u044C \u043D\u0435 \u043E\u0442\u043A\u0440\u044B\u0432\u0430\u0435\u0442\u0441\u044F."
    onEnterEffects:
    - flagKey: s2_q1
      type: 1
      value: 0
    - flagKey: s2_q2
      type: 1
      value: 0
    choices: []
    nextNodeId: hub
    isEnding: 0
    endingId: 
  - id: hub
    speaker: "\u041E\u043F\u0435\u0440\u0430\u0442\u043E\u0440 (\u041B\u0438\u043D\u0438\u044F
      \u0441\u0432\u044F\u0437\u0438)"
    text: "\u0423\u0442\u043E\u0447\u043D\u0438\u0442\u0435 \u0434\u0435\u0442\u0430\u043B\u0438
      \u0438\u043B\u0438 \u0434\u0430\u0439\u0442\u0435 \u0438\u043D\u0441\u0442\u0440\u0443\u043A\u0446\u0438\u044E
      \u043F\u043E\u0441\u0442\u0440\u0430\u0434\u0430\u0432\u0448\u0435\u0439:"
    onEnterEffects: []
    choices:
    - text: "\u0412\u044B \u0440\u0430\u043D\u0435\u043D\u044B?"
      targetNodeId: q_wound
      conditions:
      - flagKey: s2_q1
        comparison: 1
        value: 0
      effects:
      - flagKey: s2_q1
        type: 0
        value: 0
      hideIfUnavailable: 1
    - text: "\u0427\u0442\u043E \u0438\u043C\u0435\u043D\u043D\u043E \u0432\u044B\u0440\u043E\u0441\u043B\u043E
        \u043D\u0430 \u0441\u0442\u0435\u043D\u0430\u0445?"
      targetNodeId: q_walls
      conditions:
      - flagKey: s2_q2
        comparison: 1
        value: 0
      effects:
      - flagKey: s2_q2
        type: 0
        value: 0
      hideIfUnavailable: 1
    - text: "\u041D\u0435 \u0434\u0432\u0438\u0433\u0430\u0439\u0442\u0435\u0441\u044C
        \u0438 \u043D\u0435 \u0442\u0440\u043E\u0433\u0430\u0439\u0442\u0435 \u043D\u0438\u0442\u0438.
        \u041F\u043E\u043C\u043E\u0449\u044C \u0435\u0434\u0435\u0442."
      targetNodeId: end_advice
      conditions: []
      effects: []
      hideIfUnavailable: 1
    nextNodeId: 
    isEnding: 0
    endingId: 
  - id: q_wound
    speaker: "\u0417\u0432\u043E\u043D\u044F\u0449\u0430\u044F"
    text: "\u041D\u0435\u043C\u043D\u043E\u0433\u043E. \u041D\u043E\u0433\u0430.
      \u041D\u0438\u0442\u0438 \u043E\u0431\u0432\u0438\u043B\u0438 \u0435\u0451.
      \u042F \u043D\u0435 \u0434\u0432\u0438\u0433\u0430\u044E\u0441\u044C, \u0442\u0430\u043A
      \u0441\u043F\u043E\u043A\u043E\u0439\u043D\u0435\u0435."
    onEnterEffects: []
    choices: []
    nextNodeId: hub
    isEnding: 0
    endingId: 
  - id: q_walls
    speaker: "\u0417\u0432\u043E\u043D\u044F\u0449\u0430\u044F"
    text: "\u0422\u0451\u043C\u043D\u043E\u0435. \u0422\u043E\u043D\u043A\u043E\u0435,
      \u043A\u0430\u043A \u043D\u0438\u0442\u0438. \u0420\u0430\u0441\u0442\u0451\u0442
      \u043E\u0442 \u043F\u043E\u043B\u0430. \u041E\u043D\u043E \u0442\u044F\u043D\u0435\u0442\u0441\u044F
      \u043A\u043E \u043C\u043D\u0435. \u041C\u0435\u0434\u043B\u0435\u043D\u043D\u043E.
      \u041E\u043D\u043E \u043D\u0435 \u0442\u043E\u0440\u043E\u043F\u0438\u0442\u0441\u044F."
    onEnterEffects: []
    choices: []
    nextNodeId: hub
    isEnding: 0
    endingId: 
  - id: end_advice
    speaker: "\u0417\u0432\u043E\u043D\u044F\u0449\u0430\u044F"
    text: "\u0425\u043E\u0440\u043E\u0448\u043E. \u0422\u043E\u043B\u044C\u043A\u043E
      \u0441\u043A\u043E\u0440\u0435\u0435, \u043F\u043E\u0436\u0430\u043B\u0443\u0439\u0441\u0442\u0430."
