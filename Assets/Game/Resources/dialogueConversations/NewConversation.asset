  conversationId: conv_01
  startNodeId: start
  nodes:
  - id: start
    speaker: '?'
    text: "\u0410\u043B\u043B\u043E! \u0410\u043B\u043B\u043E, \u0432\u044B \u0441\u043B\u044B\u0448\u0438\u0442\u0435?
      \u0422\u0430\u043C \u043A\u0442\u043E-\u0442\u043E \u0445\u043E\u0434\u0438\u0442
      \u043F\u043E\u0434 \u043E\u043A\u043D\u043E\u043C, \u044F \u0432\u0438\u0434\u0435\u043B
      \u0442\u0435\u043D\u044C, \u043F\u043E\u0436\u0430\u043B\u0443\u0439\u0441\u0442\u0430,
      \u043F\u0440\u0438\u0435\u0437\u0436\u0430\u0439\u0442\u0435!"
    onEnterEffects: []
    choices:
    - text: "\u041D\u0430\u0437\u043E\u0432\u0438\u0442\u0435 \u0430\u0434\u0440\u0435\u0441."
      targetNodeId: Answer1
      conditions: []
      effects: []
      hideIfUnavailable: 0
    nextNodeId: 
    isEnding: 0
    endingId: 
  - id: Answer1
    speaker: '?'
    text: "\u041A\u043B\u0435\u043D\u043E\u0432\u0430\u044F, \u0434\u0432\u0430\u0434\u0446\u0430\u0442\u044C...
      \u043D\u0435\u0442, \u043F\u043E\u0434\u043E\u0436\u0434\u0438\u0442\u0435,
      \u044D\u0442\u043E \u0440\u044F\u0434\u043E\u043C \u0441 \u0431\u0443\u043B\u043E\u0447\u043D\u043E\u0439,
      \u0442\u0430\u043C\r\n\u0434\u0432\u0435\u0440\u044C \u043A\u0440\u0430\u0441\u043D\u0430\u044F!"
    onEnterEffects: []
    choices:
    - text: "\u041E\u043F\u0438\u0448\u0438\u0442\u0435, \u0447\u0442\u043E \u0432\u044B
        \u0432\u0438\u0434\u0435\u043B\u0438."
      targetNodeId: Answer11
      conditions: []
      effects: []
      hideIfUnavailable: 0
    nextNodeId: 
    isEnding: 0
    endingId: 
  - id: Answer11
    speaker: '?'
    text: "\u041D\u0443... \u0442\u0451\u043C\u043D\u0430\u044F \u0442\u0430\u043A\u0430\u044F,
      \u0432\u044B\u0441\u043E\u043A\u0430\u044F. \u0425\u043E\u0434\u0438\u043B\u0430
      \u0442\u0443\u0434\u0430-\u0441\u044E\u0434\u0430. \u042F \u043D\u0435 \u0440\u0430\u0437\u0433\u043B\u044F\u0434\u0435\u043B,
      \u043C\u043D\u0435\r\n\u0441\u0442\u0440\u0430\u0448\u043D\u043E!"
    onEnterEffects: []
    choices:
    - text: "\u0424\u043E\u043D\u0430\u0440\u044C \u0432\u043E \u0434\u0432\u043E\u0440\u0435
        \u0433\u043E\u0440\u0438\u0442?"
      targetNodeId: Answer111
      conditions: []
      effects: []
      hideIfUnavailable: 0
    nextNodeId: 
    isEnding: 0
    endingId: 
  - id: Answer111
    speaker: '?'
    text: "\u0413\u043E\u0440\u0438\u0442! \u0418 \u0442\u0435\u043D\u044C \u0445\u043E\u0434\u0438\u0442
